# Local services only. Do not add account passwords or access tokens here.
MFE_PORT=5190
MFE_BRIDGE_PORT=8791
MFE_MODE=auto
MFE_OPEN_BROWSER=true
# Default UTC. If your broker emits server-wall-clock timestamps, set its IANA zone.
# XM Global on this installation: Europe/Athens (GMT+2 winter, GMT+3 summer).
MFE_MT5_SERVER_TIMEZONE=UTC
# Optional manual tickets. Default off; Real/contest accounts are always rejected.
MFE_ENABLE_MANUAL_DEMO=false
# Python 3.11+ is optional for historical mode and required for MT5 on Windows.
# MFE_PYTHON=C:\Path\To\Python\python.exe
